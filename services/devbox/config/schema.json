{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:blackoutsecure:endpoint-toolkit:devbox:1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion"],
  "properties": {
    "schemaVersion": {"type": "integer", "minimum": 1, "maximum": 1},
    "name": {
      "$ref": "urn:blackoutsecure:endpoint-toolkit:configuration:1#/$defs/name",
      "x-env": "DEVBOX_NAME"
    },
    "backupHour": {
      "$ref": "urn:blackoutsecure:endpoint-toolkit:configuration:1#/$defs/hour",
      "x-env": "DEVBOX_BACKUP_HOUR"
    },
    "backupMinute": {
      "$ref": "urn:blackoutsecure:endpoint-toolkit:configuration:1#/$defs/minute",
      "x-env": "DEVBOX_BACKUP_MINUTE"
    },
    "retention": {
      "$ref": "urn:blackoutsecure:endpoint-toolkit:configuration:1#/$defs/positiveInteger",
      "x-env": "DEVBOX_RETENTION"
    },
    "workspaceDirectories": {
      "$ref": "urn:blackoutsecure:endpoint-toolkit:configuration:1#/$defs/directories"
    },
    "windows": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sizeGiB": {"type": "integer", "minimum": 50, "maximum": 65536},
        "volumeLabel": {
          "$ref": "urn:blackoutsecure:endpoint-toolkit:configuration:1#/$defs/label"
        },
        "preferredDriveLetters": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[A-Z]$"}
        }
      }
    },
    "macos": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sizeGB": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65536,
          "x-env": "DEVBOX_SIZE_GB"
        },
        "volumeLabel": {
          "$ref": "urn:blackoutsecure:endpoint-toolkit:configuration:1#/$defs/label",
          "x-env": "DEVBOX_VOLUME_LABEL"
        },
        "launchdPrefix": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9.-]{0,127}$",
          "x-env": "DEVBOX_LAUNCHD_PREFIX"
        },
        "repairMount": {"type": "boolean", "x-env": "DEVBOX_REPAIR_MOUNT"},
        "hideVolume": {"type": "boolean", "x-env": "DEVBOX_HIDE_VOLUME"},
        "backupIfOverdueHours": {
          "$ref": "urn:blackoutsecure:endpoint-toolkit:configuration:1#/$defs/positiveInteger",
          "x-env": "DEVBOX_BACKUP_IF_OVERDUE_HOURS"
        },
        "autoRestore": {"type": "boolean", "x-env": "DEVBOX_AUTO_RESTORE"},
        "restoreSearchAllMachines": {"type": "boolean", "x-env": "DEVBOX_RESTORE_SEARCH_ALL_MACHINES"},
        "verifyBackupHash": {"type": "boolean", "x-env": "DEVBOX_VERIFY_BACKUP_HASH"},
        "allowBackupWithoutMetadata": {"type": "boolean", "x-env": "DEVBOX_ALLOW_BACKUP_WITHOUT_METADATA"},
        "validateBackupMount": {"type": "boolean", "x-env": "DEVBOX_VALIDATE_BACKUP_MOUNT"},
        "verifyPostBackupHash": {"type": "boolean", "x-env": "DEVBOX_VERIFY_POST_BACKUP_HASH"},
        "conditionalInstallBackup": {"type": "boolean", "x-env": "DEVBOX_CONDITIONAL_INSTALL_BACKUP"},
        "backupAfterRestore": {"type": "boolean", "x-env": "DEVBOX_BACKUP_AFTER_RESTORE"}
      }
    }
  }
}
